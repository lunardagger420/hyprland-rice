* {
    /* Background scale */
    bg0: {{colors.surface_container_lowest.default.hex}};
    bg1: {{colors.surface_container_low.default.hex}};
    bg2: {{colors.surface_container.default.hex}};
    bg3: {{colors.surface_container_high.default.hex}};
    bg4: {{colors.surface_container_highest.default.hex}};

    /* Foreground / Text */
    fg:  {{colors.on_surface.default.hex}};

    /* Accent colors */
    red:    {{colors.error.default.hex}};
    orange: {{colors.tertiary.default.hex}};
    yellow: {{colors.secondary.default.hex}};
    green:  {{colors.primary.default.hex}};
    aqua:   {{colors.primary_container.default.hex}};
    blue:   {{colors.secondary_container.default.hex}};
    purple: {{colors.tertiary_container.default.hex}};

    /* Semantic aliases matching your style */
    background:     var(bg0);
    background-alt: var(bg1);
    foreground:     var(fg);
    selected:       var(blue);
    active:         var(aqua);
    urgent:         var(red);
}
