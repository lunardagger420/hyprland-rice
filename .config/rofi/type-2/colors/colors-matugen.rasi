* {
    /* Background scale */
    bg0: #090f0e;
    bg1: #171d1b;
    bg2: #1b211f;
    bg3: #252b29;
    bg4: #303634;

    /* Foreground / Text */
    fg:  #dee4e0;

    /* Accent colors */
    red:    #ffb4ab;
    orange: #aacbe4;
    yellow: #b1ccc3;
    green:  #85d6c1;
    aqua:   #005143;
    blue:   #334b45;
    purple: #2a4a5f;

    /* Semantic aliases matching your style */
    background:     var(bg0);
    background-alt: var(bg1);
    foreground:     var(fg);
    selected:       var(blue);
    active:         var(aqua);
    urgent:         var(red);
}
